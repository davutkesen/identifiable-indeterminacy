% ---------------------------------------------------------------- colour
/rgb { 3 { 255 div 3 1 roll } repeat setrgbcolor } bind def      % R G B (0-255)
/vir { 3 mul VIRIDIS exch 3 getinterval { 255 div } forall setrgbcolor } bind def   % index (0-255)
/FR /FigSans findfont def
/FI /FigSans-Italic findfont def

% ------------------------------------------------------------------ paths
/M { moveto } bind def
/L { lineto } bind def
/S { stroke } bind def
/N { newpath } bind def
/SG { newpath 4 2 roll moveto lineto stroke } bind def           % x1 y1 x2 y2
/RS { newpath 4 2 roll moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath stroke } bind def  % x y w h
/RF { newpath 4 2 roll moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath fill } bind def    % x y w h

% ------------------------------------------------------------------- text
% A text is an array of segments [font size rise (string)], font 0 upright,
% 1 italic.  The interpreter measures it, so alignment needs no metrics.
/segfont { aload pop 4 2 roll exch 0 eq { FR } { FI } ifelse exch scalefont setfont exch } bind def
/tw { 0 exch { segfont pop stringwidth pop add } forall } bind def
/tshow { { segfont dup 0 exch rmoveto exch show neg 0 exch rmoveto } forall } bind def
% x y align text T      align 0 left, 1 centre, 2 right
/T { 4 dict begin /sg exch def /al exch def /yy exch def /xx exch def
     xx sg tw al mul 2 div sub yy moveto sg tshow end } bind def
% x y angle align text TR
/TR { 6 dict begin /sg exch def /al exch def /an exch def /yy exch def /xx exch def
      gsave xx yy translate an rotate 0 0 al sg T grestore end } bind def
% xc yc leading pad [texts] BT    lines centred in a white box framed in the current colour
/BT { 10 dict begin /tl exch def /pd exch def /ld exch def /yc exch def /xc exch def
      /mw 0 def tl { tw dup mw gt { /mw exch def } { pop } ifelse } forall
      /n tl length def /hh n ld mul def
      newpath xc mw 2 div sub pd sub yc hh 2 div sub pd sub moveto
      mw pd 2 mul add 0 rlineto 0 hh pd 2 mul add rlineto mw pd 2 mul add neg 0 rlineto closepath
      gsave 1 setgray fill grestore stroke
      0 1 n 1 sub { /i exch def
        xc yc hh 2 div add ld i 1 add mul sub ld 0.30 mul add 1 tl i get T } for
      end } bind def

% ---------------------------------------------------------------- markers
% x y r Mx      r is half the width of the marker
/MO  { newpath 0 360 arc closepath fill } bind def
/MOo { newpath 0 360 arc closepath stroke } bind def
/sqpath { 3 dict begin /r exch def /y exch def /x exch def newpath x r sub y r sub moveto
          r 2 mul 0 rlineto 0 r 2 mul rlineto r 2 mul neg 0 rlineto closepath end } bind def
/MS  { sqpath fill } bind def
/MSo { sqpath stroke } bind def
/MT  { 3 dict begin /r exch def /y exch def /x exch def newpath x y r add moveto
       x r sub y r sub lineto x r add y r sub lineto closepath fill end } bind def
/MV  { 3 dict begin /r exch def /y exch def /x exch def newpath x y r sub moveto
       x r sub y r add lineto x r add y r add lineto closepath fill end } bind def
/MD  { 3 dict begin /r exch 1.4142 mul def /y exch def /x exch def newpath x y r add moveto
       x r add y lineto x y r sub lineto x r sub y lineto closepath fill end } bind def
/MX  { 3 dict begin /r exch def /y exch def /x exch def newpath x r sub y r sub moveto x r add y r add lineto
       x r sub y r add moveto x r add y r sub lineto stroke end } bind def
/MSTAR { 4 dict begin /r exch def /y exch def /x exch def newpath
       0 1 9 { /i exch def
         i 2 mod 0 eq { r } { r 0.382 mul } ifelse
         dup i 36 mul 90 add cos mul x add exch i 36 mul 90 add sin mul y add
         i 0 eq { moveto } { lineto } ifelse } for
       closepath stroke end } bind def

% --------------------------------------------------------------- heat map
% x y w h n {profile} K HM
% An n-by-n image over the rectangle.  The value at pixel (i, j) is
% (p_i + p_j) / (2 K) with p the profile, a value between 0 and 1 that is
% shown in the colours of VIRIDIS.  Integer arithmetic throughout.
/HM { 12 dict begin /K exch def /pf exch cvlit def /n exch def /h exch def /w exch def /y exch def /x exch def
      /row n string def /j 0 def
      gsave x y translate w h scale
      [/Indexed /DeviceRGB 255 VIRIDIS] setcolorspace
      << /ImageType 1 /Width n /Height n /BitsPerComponent 8 /Decode [0 255]
         /ImageMatrix [n 0 0 n 0 0]
         /DataSource { /pj pf j get def
                       0 1 n 1 sub { dup pf exch get pj add 256 mul K 2 mul idiv
                                     dup 255 gt { pop 255 } if row 3 1 roll put } for
                       /j j 1 add def row }
      >> image
      grestore end } bind def
% x y w h CB    the colours of VIRIDIS from bottom to top
/CB { 6 dict begin /h exch def /w exch def /y exch def /x exch def
      /row 256 string def 0 1 255 { row exch dup put } for
      gsave x y translate w h scale
      [/Indexed /DeviceRGB 255 VIRIDIS] setcolorspace
      << /ImageType 1 /Width 1 /Height 256 /BitsPerComponent 8 /Decode [0 255]
         /ImageMatrix [1 0 0 256 0 0] /DataSource row >> image
      grestore end } bind def
%%EndResource
